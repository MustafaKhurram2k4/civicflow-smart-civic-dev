# MongoDB Database
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=smart_civic_db

# Security & JWT
JWT_SECRET_KEY=generate_a_long_random_secret_string_here_min_32_chars

# Google OAuth (Optional - required only if Google Sign-In is enabled)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudinary (Required for complaint image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini AI (Required for AI categorization & municipal PDF reports)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
BACKEND_CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173
